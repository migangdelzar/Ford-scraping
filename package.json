{
  "name": "ford-uruapan-hybrid-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "eval:mcp": "tsx scripts/evaluate-mcp-flows.mjs",
    "eval:mcp:llm": "tsx scripts/evaluate-mcp-llm-flows.mjs",
    "eval:mcp:leads": "tsx scripts/evaluate-mcp-multistep-leads.mjs",
    "eval:mcp:leads:ragas": "evals/multistep-leads/ragas/.venv/bin/python evals/multistep-leads/ragas/score_traces.py",
    "lint": "gts lint src tests scripts vitest.config.ts",
    "format": "gts fix src tests scripts vitest.config.ts",
    "migrate": "tsx src/cli.ts migrate",
    "db:backup": "node scripts/backup-database.mjs",
    "eval:mcp:catalog-qa": "tsx scripts/evaluate-mcp-catalog-qa.mjs",
    "eval:mcp:catalog-qa:ragas": "evals/multistep-leads/ragas/.venv/bin/python evals/catalog-qa/ragas/score_traces.py",
    "eval:semantic-retrieval": "tsx scripts/evaluate-semantic-retrieval.mjs"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.1",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.5.0",
    "node-cron": "^4.6.0",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.5",
    "gts": "^7.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
