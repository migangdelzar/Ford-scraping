DATABASE_URL=postgres://postgres:postgres@localhost:5432/ford
FORD_BASE_URL=https://www.forduruapan.mx
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_URL=http://127.0.0.1:11435/api/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qllama/bge-m3:q8_0
EMBEDDING_DIMENSIONS=1024
CRAWL_MAX_PAGES=1000
CRAWL_CONCURRENCY=3
SYNC_SCHEDULE=0 12 * * *
SYNC_TIMEZONE=America/Mexico_City

# Optional Langfuse/OpenTelemetry tracing. Leave unset to disable telemetry.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Optional remote MCP transport. Keep it bound to localhost and protect it.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001
MCP_HTTP_BEARER_TOKEN=
MCP_HTTP_ALLOWED_ORIGINS=
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
